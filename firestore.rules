rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // --- agora-debates subproject ---
    // ==========================================
    match /agora-debates_users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /agora-debates_debates/{debateId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
      
      match /arguments/{argumentId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
        
        match /rebuttals/{rebuttalId} {
          allow read: if true;
          allow create, update: if request.auth != null;
          allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
        }

        match /votes/{voterId} {
          allow read: if true;
          allow create, update, delete: if request.auth != null;
        }
      }
    }

    // ==========================================
    // --- thriftflip subproject ---
    // ==========================================
    match /thriftflip_transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid
      );
      allow write: if false;
    }

    // ==========================================
    // --- eisenhower-matrices subproject ---
    // ==========================================
    match /eisenhower-matrices_users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /eisenhower-matrices_matrices/{matrixId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (request.auth.token.email != null && request.auth.token.email in resource.data.sharedEmails)
      );
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (request.auth.token.email != null && request.auth.token.email in resource.data.sharedEmails)
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Fallback rule for all other subprojects
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
